# URL pública final (sem barra no fim)
PUBLIC_SITE_URL=https://sinal.studio

# Contactos públicos. O telefone só aparece quando ambos os valores existem.
PUBLIC_CONTACT_EMAIL=hello@sinal.studio
PUBLIC_PHONE_DISPLAY=
PUBLIC_PHONE_HREF=
PUBLIC_BOOKING_URL=

# Identificação legal. Preencher antes do lançamento comercial.
PUBLIC_LEGAL_NAME=
PUBLIC_LEGAL_NIF=
PUBLIC_LEGAL_ADDRESS=

# Formulários por email (Resend)
RESEND_API_KEY=
FORM_FROM_EMAIL=Sinal Studio <formularios@seudominio.pt>
CONTACT_TO_EMAIL=
SITE_URL=https://sinal.studio

# Proteção anti-spam opcional (Cloudflare Turnstile)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics sem cookies, opcional. Não é carregado quando está vazio.
PUBLIC_PLAUSIBLE_DOMAIN=

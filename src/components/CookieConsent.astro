---
interface Props {
  domain?: string;
}

const { domain = '' } = Astro.props;
---

{
  domain && (
    <aside class="cookie-banner" aria-label="Preferências de privacidade" hidden data-cookie-banner data-domain={domain}>
      <div>
        <strong>Analytics sob o seu controlo.</strong>
        <p>
          Gostaríamos de medir a utilização do website com analytics respeitador da privacidade. Não carregamos
          esta ferramenta antes da sua escolha. <a href="/cookies">Saber mais</a>.
        </p>
      </div>
      <div class="cookie-actions">
        <button class="button button--line" type="button" data-cookie-reject>Recusar</button>
        <button class="button button--dark" type="button" data-cookie-accept>Aceitar</button>
      </div>
    </aside>
  )
}

<dialog class="privacy-dialog" data-privacy-dialog aria-labelledby="privacy-title">
  <button class="dialog-close" type="button" data-privacy-close aria-label="Fechar">×</button>
  <span class="eyebrow">Privacidade</span>
  <h2 id="privacy-title">As suas preferências</h2>
  {
    domain ? (
      <>
        <p>Os analytics opcionais estão <strong data-consent-state>por decidir</strong>.</p>
        <div class="dialog-actions">
          <button class="button button--line" type="button" data-cookie-reject>Recusar</button>
          <button class="button button--dark" type="button" data-cookie-accept>Aceitar</button>
        </div>
      </>
    ) : (
      <p>
        Neste momento não utilizamos cookies opcionais nem carregamos analytics. Por isso, não apresentamos um
        banner de consentimento.
      </p>
    )
  }
  <a class="text-link" href="/cookies">Consultar política de cookies <span>↗</span></a>
</dialog>

<script is:inline define:vars={{ domain }}>
  const storageKey = 'sinal-privacy-choice';
  const banner = document.querySelector('[data-cookie-banner]');
  const dialog = document.querySelector('[data-privacy-dialog]');
  const stateLabels = document.querySelectorAll('[data-consent-state]');

  const getChoice = () => {
    try {
      return window.localStorage.getItem(storageKey);
    } catch {
      return null;
    }
  };

  const loadAnalytics = () => {
    if (!domain || document.querySelector('script[data-sinal-analytics]')) return;
    const script = document.createElement('script');
    script.defer = true;
    script.dataset.domain = domain;
    script.dataset.sinalAnalytics = 'true';
    script.src = 'https://plausible.io/js/script.js';
    document.head.append(script);
  };

  const updateState = (choice) => {
    stateLabels.forEach((label) => {
      label.textContent = choice === 'accepted' ? 'ativos' : choice === 'rejected' ? 'desativados' : 'por decidir';
    });
  };

  const choose = (choice) => {
    try {
      window.localStorage.setItem(storageKey, choice);
    } catch {
      // A preferência continua válida apenas durante a sessão quando o armazenamento está bloqueado.
    }
    banner?.setAttribute('hidden', '');
    updateState(choice);
    if (choice === 'accepted') loadAnalytics();
  };

  const initial = getChoice();
  updateState(initial);
  if (domain && !initial) banner?.removeAttribute('hidden');
  if (initial === 'accepted') loadAnalytics();

  document.querySelectorAll('[data-cookie-accept]').forEach((button) =>
    button.addEventListener('click', () => choose('accepted')),
  );
  document.querySelectorAll('[data-cookie-reject]').forEach((button) =>
    button.addEventListener('click', () => choose('rejected')),
  );
  document.querySelectorAll('[data-cookie-settings]').forEach((button) =>
    button.addEventListener('click', () => dialog?.showModal()),
  );
  document.querySelector('[data-privacy-close]')?.addEventListener('click', () => dialog?.close());
</script>

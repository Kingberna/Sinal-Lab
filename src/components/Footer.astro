---
import { siteConfig } from '@/config/site';
import { services } from '@/data/services';
---

<footer class="site-footer">
  <div class="footer-head">
    <a class="brand brand--footer" href="/" aria-label={`${siteConfig.name}, página inicial`}>
      <span class="brand-mark" aria-hidden="true"><i></i></span>
      <span>SINAL</span>
    </a>
    <p>{siteConfig.tagline}</p>
  </div>
  <div class="footer-grid">
    <div class="footer-contact">
      <span class="eyebrow">Um projeto em mente?</span>
      <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}<span aria-hidden="true">↗</span></a>
      {siteConfig.phone.href && <a class="footer-phone" href={siteConfig.phone.href}>{siteConfig.phone.display}</a>}
      <p>{siteConfig.responseTime}</p>
    </div>
    <nav aria-label="Serviços no rodapé">
      <span class="eyebrow">Serviços</span>
      {services.map((service) => <a href={`/servicos/${service.slug}`}>{service.shortTitle}</a>)}
    </nav>
    <nav aria-label="Empresa no rodapé">
      <span class="eyebrow">Sinal</span>
      {siteConfig.navigation.slice(1).map((item) => <a href={item.href}>{item.label}</a>)}
      <a href="/contacto">Contacto</a>
    </nav>
    <nav aria-label="Informação legal no rodapé">
      <span class="eyebrow">Informação</span>
      <a href="/privacidade">Privacidade</a>
      <a href="/cookies">Cookies</a>
      <a href="/informacao-legal">Informação legal</a>
      <button type="button" data-cookie-settings>Preferências de privacidade</button>
    </nav>
  </div>
  <div class="footer-bottom">
    <p>© {new Date().getFullYear()} {siteConfig.name}. Todos os direitos reservados.</p>
    <p>Portugal · A trabalhar com empresas em todo o país.</p>
    <a href="#main-content">Voltar ao início <span aria-hidden="true">↑</span></a>
  </div>
</footer>

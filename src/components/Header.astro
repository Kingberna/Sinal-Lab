---
import { siteConfig } from '@/config/site';
import { serviceAreas } from '@/data/serviceAreas';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const isCurrent = (href: string) => (href === '/' ? currentPath === href : currentPath.startsWith(href));
const headerNavigation = siteConfig.navigation.filter((item) => item.href !== '/sobre');
---

<header class:list={['site-header', currentPath === '/' && 'site-header--home']} data-header>
  <a class="brand" href="/" aria-label={`${siteConfig.name}, página inicial`}>
    <span class="brand-mark" aria-hidden="true"><i></i></span>
    <span>SINAL</span>
  </a>

  <nav class="desktop-nav" aria-label="Navegação principal">
    <details class="mega-menu" data-mega>
      <summary aria-label="Abrir serviços">Serviços <span aria-hidden="true">＋</span></summary>
      <div class="mega-panel">
        <div class="mega-intro">
          <span class="eyebrow">O que fazemos</span>
          <div class="mega-intro-copy">
            <h2>Do primeiro website ao próximo passo do seu negócio.</h2>
            <p>Criamos, renovamos e melhoramos websites para ajudar empresas a crescer.</p>
          </div>
          <a class="text-link" href="/servicos">Descobrir como podemos ajudar <span>↗</span></a>
        </div>
        <div class="mega-services">
          {serviceAreas.map((service) => (
            <a href={service.href}>
              <span>{service.number}</span>
              <i aria-hidden="true">↗</i>
              <strong>{service.title}</strong>
              <p>{service.description}</p>
            </a>
          ))}
        </div>
      </div>
    </details>
    {headerNavigation.slice(1).map((item) => (
      <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
    ))}
  </nav>

  <a class="header-cta" href="/diagnostico">
    Pedir diagnóstico
    <span aria-hidden="true">↗</span>
  </a>

  <button class="menu-trigger" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-open>
    <span class="sr-only">Abrir menu</span>
    <i></i><i></i>
  </button>

  <div class="mobile-menu" id="mobile-menu" hidden data-mobile-menu>
    <div class="mobile-menu-top">
      <a class="brand brand--inverse" href="/" aria-label={`${siteConfig.name}, página inicial`}>
        <span class="brand-mark" aria-hidden="true"><i></i></span>
        <span>SINAL</span>
      </a>
      <button class="menu-close" type="button" data-menu-close>
        <span>Fechar</span><i aria-hidden="true">×</i>
      </button>
    </div>
    <nav aria-label="Navegação mobile">
      {
        headerNavigation.map((item, index) =>
          item.href === '/servicos' ? (
            <details class="mobile-services" data-mobile-services>
              <summary>
                <span>0{index + 1}</span>
                {item.label}
                <i aria-hidden="true">＋</i>
              </summary>
              <div class="mobile-service-list">
                {serviceAreas.map((service) => (
                  <a href={service.href} aria-current={isCurrent(service.href) ? 'page' : undefined}>
                    <span>{service.number}</span>
                    <strong>{service.title}</strong>
                    <p>{service.description}</p>
                    <i aria-hidden="true">↗</i>
                  </a>
                ))}
                <a class="mobile-services-all" href="/servicos">
                  Descobrir como podemos ajudar <i aria-hidden="true">↗</i>
                </a>
              </div>
            </details>
          ) : (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              <span>0{index + 1}</span>{item.label}<i aria-hidden="true">↗</i>
            </a>
          ),
        )
      }
    </nav>
    <div class="mobile-menu-bottom">
      <a class="button button--signal" href="/diagnostico">Pedir diagnóstico gratuito <span>↗</span></a>
      <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
    </div>
    <div class="mobile-signal" aria-hidden="true"><i></i><i></i><i></i></div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  const openButton = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeButton = document.querySelector<HTMLButtonElement>('[data-menu-close]');
  const mega = document.querySelector<HTMLDetailsElement>('[data-mega]');
  const mobileServices = document.querySelector<HTMLDetailsElement>('[data-mobile-services]');
  let previousFocus: HTMLElement | null = null;

  const setHeader = () => header?.toggleAttribute('data-scrolled', window.scrollY > 16);
  window.addEventListener('scroll', setHeader, { passive: true });
  setHeader();

  const getFocusable = () =>
    Array.from(
      menu?.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])') || [],
    );

  const openMenu = () => {
    if (!menu || !openButton) return;
    previousFocus = document.activeElement as HTMLElement;
    menu.hidden = false;
    requestAnimationFrame(() => menu.setAttribute('data-open', ''));
    document.body.setAttribute('data-menu-open', '');
    openButton.setAttribute('aria-expanded', 'true');
    closeButton?.focus();
  };

  const closeMenu = () => {
    if (!menu || !openButton || menu.hidden) return;
    menu.removeAttribute('data-open');
    document.body.removeAttribute('data-menu-open');
    openButton.setAttribute('aria-expanded', 'false');
    window.setTimeout(() => {
      menu.hidden = true;
      mobileServices?.removeAttribute('open');
    }, 240);
    previousFocus?.focus();
  };

  openButton?.addEventListener('click', openMenu);
  closeButton?.addEventListener('click', closeMenu);
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      if (menu && !menu.hidden) closeMenu();
      if (mega?.open) mega.open = false;
    }
    if (event.key === 'Tab' && menu && !menu.hidden) {
      const focusable = getFocusable();
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      }
    }
  });
</script>

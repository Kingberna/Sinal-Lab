---
import ButtonLink from './ButtonLink.astro';

const guarantees = [
  {
    title: 'Sem compromisso',
    text: 'Uma conversa simples e direta.',
  },
  {
    title: 'Resposta rápida',
    text: 'Normalmente, respondemos até 2 dias úteis.',
  },
  {
    title: 'Próximo passo claro',
    text: 'Orientação prática, sem linguagem técnica.',
  },
];
---

<section class="home-growth-cta" aria-labelledby="growth-title" data-growth-cta>
  <div class="section-shell home-growth-inner">
    <div class="home-growth-copy">
      <span class="eyebrow">O próximo passo</span>
      <h2 id="growth-title">Vamos criar um website que trabalhe pelo seu negócio?</h2>
      <div class="home-growth-actions">
        <p>Comece por um diagnóstico gratuito, sem compromisso.</p>
        <div class="button-row">
          <ButtonLink href="/diagnostico" label="Pedir diagnóstico gratuito" variant="signal" />
          <a class="text-link" href="/projetos"><span>Ver projetos</span><i aria-hidden="true">↗</i></a>
        </div>
      </div>
    </div>

    <aside class="home-diagnostic" aria-labelledby="diagnostic-title">
      <div class="home-diagnostic-orbit" aria-hidden="true">
        <i></i><i></i><i></i>
        <b></b>
      </div>

      <div class="home-diagnostic-content">
        <span class="eyebrow">Começar com clareza</span>
        <h3 id="diagnostic-title">Diagnóstico gratuito</h3>
        <p>Percebemos o ponto em que está, identificamos o que pode melhorar e indicamos o próximo passo.</p>

        <ul>
          {
            guarantees.map((guarantee, index) => (
              <li>
                <i class:list={{ 'is-lime': index === 1 }} aria-hidden="true"></i>
                <div>
                  <strong>{guarantee.title}</strong>
                  <span>{guarantee.text}</span>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </aside>
  </div>
</section>

<script>
  const growthCtas = Array.from(document.querySelectorAll<HTMLElement>('[data-growth-cta]'));

  growthCtas.forEach((cta) => {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const finePointer = window.matchMedia('(pointer: fine)');
    let pointerFrame = 0;

    const applyMotionPreference = () => {
      if (reducedMotion.matches) {
        cta.classList.remove('is-ready');
        cta.classList.add('is-visible');
      } else {
        cta.classList.add('is-ready');
      }
    };

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (!entry?.isIntersecting) return;
          cta.classList.add('is-visible');
          observer.unobserve(cta);
        },
        { threshold: 0.18 },
      );
      observer.observe(cta);
    } else {
      cta.classList.add('is-visible');
    }

    cta.addEventListener('pointermove', (event) => {
      if (reducedMotion.matches || !finePointer.matches || pointerFrame) return;

      pointerFrame = window.requestAnimationFrame(() => {
        pointerFrame = 0;
        const rect = cta.getBoundingClientRect();
        const x = ((event.clientX - rect.left) / rect.width - 0.5) * 14;
        const y = ((event.clientY - rect.top) / rect.height - 0.5) * 10;
        cta.style.setProperty('--orbit-x', `${x.toFixed(2)}px`);
        cta.style.setProperty('--orbit-y', `${y.toFixed(2)}px`);
      });
    });

    cta.addEventListener('pointerleave', () => {
      cta.style.setProperty('--orbit-x', '0px');
      cta.style.setProperty('--orbit-y', '0px');
    });

    reducedMotion.addEventListener('change', applyMotionPreference);
    applyMotionPreference();
  });
</script>

<style>
  .home-growth-cta {
    --orbit-x: 0px;
    --orbit-y: 0px;
    position: relative;
    overflow: clip;
    padding-block: clamp(5.5rem, 8vw, 8.5rem);
    isolation: isolate;
    background: var(--paper-bright);
  }

  .home-growth-cta::before {
    position: absolute;
    z-index: -2;
    opacity: 0.24;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: clamp(4rem, 7vw, 7rem) clamp(4rem, 7vw, 7rem);
    content: '';
    inset: 0;
    mask-image: linear-gradient(90deg, #000, transparent 72%);
  }

  .home-growth-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(21rem, 0.72fr);
    gap: clamp(4rem, 7vw, 8rem);
    align-items: center;
  }

  .home-growth-copy {
    position: relative;
    z-index: 2;
  }

  .home-growth-copy h2 {
    max-width: 49rem;
    margin-block: var(--space-md);
    font-size: clamp(3.9rem, 6.25vw, 7.4rem);
    line-height: 0.88;
    letter-spacing: -0.07em;
    text-wrap: balance;
  }

  .home-growth-actions > p {
    max-width: 33rem;
    color: var(--muted);
    font-size: var(--step-1);
  }

  .home-growth-actions .button-row {
    align-items: center;
    margin-top: var(--space-lg);
  }

  .home-growth-cta :global(.button--signal i) {
    transition: transform 0.3s var(--ease);
  }

  .home-growth-cta :global(.button--signal:hover i),
  .home-growth-cta :global(.button--signal:focus-visible i) {
    transform: translate(0.2rem, -0.2rem);
  }

  .home-diagnostic {
    position: relative;
    min-width: 0;
    padding: clamp(1.6rem, 3vw, 2.8rem) 0;
    isolation: isolate;
  }

  .home-diagnostic-content {
    position: relative;
    z-index: 2;
  }

  .home-diagnostic h3 {
    max-width: 23rem;
    margin-block: 0.9rem 1rem;
    font-family: var(--font-serif);
    font-size: clamp(2.15rem, 3.4vw, 3.65rem);
    font-weight: 400;
    line-height: 0.94;
    letter-spacing: -0.045em;
  }

  .home-diagnostic-content > p {
    max-width: 30rem;
    color: var(--muted);
    font-size: var(--step-0);
  }

  .home-diagnostic ul {
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .home-diagnostic li {
    display: grid;
    grid-template-columns: 0.65rem minmax(0, 1fr);
    gap: 0.85rem;
    align-items: start;
    padding-block: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--ink) 15%, transparent);
  }

  .home-diagnostic li > i {
    width: 0.48rem;
    margin-top: 0.33rem;
    border-radius: 50%;
    aspect-ratio: 1;
    background: var(--signal);
    box-shadow: 0 0 0 0.28rem rgb(255 88 56 / 10%);
  }

  .home-diagnostic li > i.is-lime {
    background: var(--lime);
    box-shadow: 0 0 0 0.28rem rgb(201 255 85 / 12%);
  }

  .home-diagnostic li div {
    display: grid;
    gap: 0.3rem;
  }

  .home-diagnostic li strong {
    font-size: 0.9rem;
  }

  .home-diagnostic li span {
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .home-diagnostic-orbit {
    position: absolute;
    z-index: 0;
    top: 50%;
    left: 50%;
    width: min(31rem, 44vw);
    border-radius: 50%;
    opacity: 0.18;
    aspect-ratio: 1;
    color: var(--ink);
    transform: translate(-50%, -50%) scale(1);
    transition: transform 0.72s var(--ease) 180ms;
  }

  .home-diagnostic-orbit i {
    position: absolute;
    border: 1px solid currentColor;
    border-radius: 50%;
    inset: calc(var(--ring, 0) * 12%);
  }

  .home-diagnostic-orbit i:nth-child(2) { --ring: 1; }
  .home-diagnostic-orbit i:nth-child(3) { --ring: 2; }

  .home-diagnostic-orbit b {
    position: absolute;
    top: 13%;
    right: 19%;
    width: 0.82rem;
    border: 3px solid var(--paper-bright);
    border-radius: 50%;
    aspect-ratio: 1;
    background: var(--signal);
    box-shadow: 0 0 0 0.55rem rgb(255 88 56 / 11%);
    transform: translate3d(var(--orbit-x), var(--orbit-y), 0);
    transition: transform 0.32s var(--ease);
  }

  .home-growth-cta.is-ready .home-growth-copy > .eyebrow,
  .home-growth-cta.is-ready .home-growth-copy h2,
  .home-growth-cta.is-ready .home-growth-actions,
  .home-growth-cta.is-ready .home-diagnostic-content {
    opacity: 0;
    transform: translateY(1rem);
  }

  .home-growth-cta.is-ready .home-diagnostic-orbit {
    transform: translate(-50%, -50%) scale(0.96);
  }

  .home-growth-copy > .eyebrow,
  .home-growth-copy h2,
  .home-growth-actions,
  .home-diagnostic-content {
    transition:
      opacity 0.58s var(--ease),
      transform 0.68s var(--ease);
  }

  .home-growth-actions {
    transition-delay: 100ms;
  }

  .home-diagnostic-content {
    transition-delay: 190ms;
  }

  .home-growth-cta.is-ready.is-visible .home-growth-copy > .eyebrow,
  .home-growth-cta.is-ready.is-visible .home-growth-copy h2,
  .home-growth-cta.is-ready.is-visible .home-growth-actions,
  .home-growth-cta.is-ready.is-visible .home-diagnostic-content {
    opacity: 1;
    transform: none;
  }

  .home-growth-cta.is-ready.is-visible .home-diagnostic-orbit {
    transform: translate(-50%, -50%) scale(1);
  }

  @media (max-width: 64rem) {
    .home-growth-inner {
      grid-template-columns: minmax(0, 1.1fr) minmax(19rem, 0.76fr);
      gap: clamp(3rem, 5vw, 5rem);
    }

    .home-growth-copy h2 {
      font-size: clamp(3.7rem, 6.6vw, 5.5rem);
    }
  }

  @media (max-width: 56rem) {
    .home-growth-cta {
      padding-block: clamp(5rem, 9vw, 6.5rem);
    }

    .home-growth-inner {
      grid-template-columns: 1fr;
      gap: clamp(4rem, 10vw, 6rem);
    }

    .home-growth-copy {
      max-width: 46rem;
    }

    .home-growth-copy h2 {
      font-size: clamp(3.7rem, 10vw, 5.6rem);
    }

    .home-diagnostic {
      width: min(100%, 39rem);
      padding: 1rem 0 0;
    }

    .home-diagnostic-orbit {
      left: 68%;
      width: min(29rem, 72vw);
    }
  }

  @media (max-width: 44rem) {
    .home-growth-copy h2 {
      font-size: clamp(3.25rem, 14vw, 4.75rem);
    }

    .home-growth-actions .button-row {
      align-items: stretch;
      flex-direction: column;
      margin-top: var(--space-md);
    }

    .home-growth-actions :global(.button) {
      width: 100%;
    }

    .home-growth-actions .text-link {
      align-self: flex-start;
      min-height: 2.75rem;
      align-items: center;
    }

    .home-diagnostic h3 {
      font-size: clamp(2.2rem, 11vw, 3.1rem);
    }

    .home-diagnostic-orbit {
      left: 72%;
      width: min(24rem, 92vw);
      opacity: 0.14;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-growth-copy > .eyebrow,
    .home-growth-copy h2,
    .home-growth-actions,
    .home-diagnostic-content,
    .home-diagnostic-orbit,
    .home-diagnostic-orbit b,
    .home-growth-cta :global(.button--signal i) {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }

    .home-diagnostic-orbit {
      transform: translate(-50%, -50%) !important;
    }
  }
</style>

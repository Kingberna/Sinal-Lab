---
interface ProcessStep {
  title: string;
  text: string;
}

interface Props {
  steps: ProcessStep[];
}

const { steps } = Astro.props;
---

<section class="home-process-story section-shell" aria-labelledby="process-title" data-process-story>
  <header class="home-process-heading">
    <span class="eyebrow">O percurso</span>
    <h2 id="process-title">Da primeira conversa ao lançamento. E depois.</h2>
  </header>

  <ol class="home-process-path" data-process-path>
    {
      steps.map((step, index) => (
        <li class:list={{ 'is-active': index === 0 }} data-process-step aria-current={index === 0 ? 'step' : undefined}>
          <i aria-hidden="true"></i>
          <small>{String(index + 1).padStart(2, '0')}</small>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))
    }
  </ol>
</section>

<script>
  const processStories = Array.from(document.querySelectorAll<HTMLElement>('[data-process-story]'));

  processStories.forEach((story) => {
    const path = story.querySelector<HTMLOListElement>('[data-process-path]');
    const steps = Array.from(story.querySelectorAll<HTMLElement>('[data-process-step]'));
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    if (!path || steps.length === 0) return;

    let frame = 0;
    let isNearViewport = true;

    const setActiveStep = (activeIndex: number) => {
      steps.forEach((step, index) => {
        const isActive = index === activeIndex;
        step.classList.toggle('is-active', isActive);
        step.classList.toggle('is-reached', index <= activeIndex);

        if (isActive) step.setAttribute('aria-current', 'step');
        else step.removeAttribute('aria-current');
      });
    };

    const showStaticProcess = () => {
      story.classList.remove('is-enhanced');
      story.classList.add('is-static');
      path.style.setProperty('--process-progress', '1');
      steps.forEach((step) => {
        step.classList.add('is-reached');
        step.classList.remove('is-active');
        step.removeAttribute('aria-current');
      });
    };

    const update = () => {
      frame = 0;
      if (!isNearViewport || reducedMotion.matches) return;

      const rect = path.getBoundingClientRect();
      const start = window.innerHeight * 0.78;
      const distance = window.innerHeight * 0.5 + rect.height * 0.55;
      const rawProgress = Math.min(1, Math.max(0, (start - rect.top) / Math.max(1, distance)));
      const progress = Math.min(1, rawProgress / 0.82);
      const activeIndex = Math.min(steps.length - 1, Math.floor(progress * (steps.length - 1) + 0.001));

      path.style.setProperty('--process-progress', progress.toFixed(4));
      setActiveStep(activeIndex);
    };

    const requestUpdate = () => {
      if (!frame) frame = window.requestAnimationFrame(update);
    };

    const applyMotionPreference = () => {
      if (reducedMotion.matches) {
        showStaticProcess();
        return;
      }

      story.classList.remove('is-static');
      story.classList.add('is-enhanced');
      path.style.setProperty('--process-progress', '0');
      setActiveStep(0);
      requestUpdate();
    };

    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate);
    reducedMotion.addEventListener('change', applyMotionPreference);

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        ([entry]) => {
          isNearViewport = Boolean(entry?.isIntersecting);
          if (isNearViewport) requestUpdate();
        },
        { rootMargin: '40% 0px' },
      );
      observer.observe(story);
    }

    applyMotionPreference();
  });
</script>

<style>
  .home-process-story {
    padding-block: clamp(5.25rem, 7.5vw, 8.5rem);
    scroll-margin-top: calc(var(--header-height) + 1.5rem);
  }

  .home-process-heading {
    display: grid;
    grid-template-columns: minmax(9rem, 0.36fr) minmax(0, 1.64fr);
    gap: var(--space-lg);
    align-items: start;
    margin-bottom: clamp(2.75rem, 4.5vw, 4.75rem);
  }

  .home-process-heading h2 {
    max-width: 58rem;
    font-size: clamp(3.45rem, 6.25vw, 7rem);
    line-height: 0.9;
    letter-spacing: -0.065em;
    text-wrap: balance;
  }

  .home-process-path {
    --process-progress: 1;
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home-process-path::before,
  .home-process-path::after {
    position: absolute;
    top: 0.48rem;
    right: 0;
    left: 0;
    height: 1px;
    content: '';
    transform-origin: left;
  }

  .home-process-path::before {
    background: color-mix(in srgb, var(--ink) 18%, transparent);
  }

  .home-process-path::after {
    background: linear-gradient(90deg, var(--signal), var(--lime));
    transform: scaleX(var(--process-progress));
    transition: transform 0.12s linear;
  }

  .home-process-path li {
    position: relative;
    min-width: 0;
    padding-top: clamp(2.7rem, 4vw, 3.8rem);
    opacity: 1;
    transition:
      opacity 0.32s ease,
      transform 0.42s var(--ease);
  }

  .home-process-story.is-enhanced .home-process-path li {
    opacity: 0.5;
    transform: translateY(0.55rem);
  }

  .home-process-story.is-enhanced .home-process-path li.is-reached {
    opacity: 0.66;
    transform: none;
  }

  .home-process-story.is-enhanced .home-process-path li.is-active {
    opacity: 1;
  }

  .home-process-path li > i {
    position: absolute;
    z-index: 2;
    top: 0;
    left: 0;
    width: 1rem;
    border: 0.22rem solid var(--paper);
    border-radius: 50%;
    aspect-ratio: 1;
    background: color-mix(in srgb, var(--ink) 24%, var(--paper));
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--ink) 42%, transparent);
    transition:
      background 0.28s ease,
      box-shadow 0.28s ease,
      transform 0.35s var(--ease);
  }

  .home-process-path li.is-reached > i {
    background: var(--signal);
  }

  .home-process-path li:nth-child(even).is-reached > i {
    background: var(--lime);
  }

  .home-process-path li.is-active > i {
    box-shadow:
      0 0 0 1px var(--ink),
      0 0 0 0.42rem rgb(255 88 56 / 12%);
    transform: scale(1.08);
  }

  .home-process-path small {
    display: block;
    margin-bottom: 0.7rem;
    color: var(--muted);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .home-process-path h3 {
    color: color-mix(in srgb, var(--ink) 68%, var(--paper));
    font-size: var(--step-2);
    transition: color 0.28s ease;
  }

  .home-process-path li.is-reached h3,
  .home-process-story:not(.is-enhanced) .home-process-path h3 {
    color: var(--ink);
  }

  .home-process-path p {
    max-width: 20rem;
    margin-top: 0.85rem;
    color: color-mix(in srgb, var(--muted) 78%, var(--paper));
    transition: color 0.28s ease;
  }

  .home-process-path li.is-active p,
  .home-process-story:not(.is-enhanced) .home-process-path p {
    color: var(--muted);
  }

  @media (max-width: 56rem) {
    .home-process-story {
      padding-block: clamp(5rem, 9vw, 6.5rem);
    }

    .home-process-heading {
      grid-template-columns: minmax(8rem, 0.32fr) minmax(0, 1.68fr);
      gap: var(--space-md);
      margin-bottom: 3rem;
    }

    .home-process-heading h2 {
      font-size: clamp(3.4rem, 9vw, 5.2rem);
    }

    .home-process-path {
      display: block;
      max-width: 48rem;
      padding-left: 2.5rem;
    }

    .home-process-path::before,
    .home-process-path::after {
      top: 0.5rem;
      bottom: 0;
      left: 0.48rem;
      width: 1px;
      height: auto;
      transform-origin: top;
    }

    .home-process-path::after {
      transform: scaleY(var(--process-progress));
    }

    .home-process-path li {
      min-height: 0;
      padding-top: 0;
      padding-bottom: clamp(2.6rem, 6vw, 3.5rem);
    }

    .home-process-path li:last-child {
      padding-bottom: 0;
    }

    .home-process-path li > i {
      top: 0;
      left: -2.5rem;
    }

    .home-process-path p {
      max-width: 34rem;
    }
  }

  @media (max-width: 44rem) {
    .home-process-heading {
      grid-template-columns: 1fr;
      gap: var(--space-md);
      margin-bottom: 2.75rem;
    }

    .home-process-heading h2 {
      font-size: clamp(3.15rem, 13.5vw, 4.8rem);
    }

    .home-process-path {
      padding-left: 2.2rem;
    }

    .home-process-path li > i {
      left: -2.2rem;
    }

    .home-process-path h3 {
      font-size: clamp(1.65rem, 8vw, 2rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-process-path::after {
      transform: scaleX(1);
      transition: none;
    }

    .home-process-path li,
    .home-process-path li > i {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }

  @media (max-width: 56rem) and (prefers-reduced-motion: reduce) {
    .home-process-path::after {
      transform: scaleY(1);
    }
  }
</style>

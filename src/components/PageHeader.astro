---
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  breadcrumbs?: Array<{ label: string; href?: string }>;
  theme?: 'paper' | 'dark' | 'signal';
}

const { eyebrow, title, intro, breadcrumbs = [], theme = 'paper' } = Astro.props;
---

<header class:list={['page-hero', `page-hero--${theme}`]}>
  <div class="page-hero-grid" aria-hidden="true"></div>
  {breadcrumbs.length > 0 && <Breadcrumbs items={breadcrumbs} />}
  <div class="page-hero-copy" data-reveal>
    <span class="eyebrow">{eyebrow}</span>
    <h1>{title}</h1>
    <p>{intro}</p>
  </div>
  <div class="page-hero-signal" aria-hidden="true"><i></i><i></i><i></i><span></span></div>
</header>

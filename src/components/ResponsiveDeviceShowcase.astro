---
import ProjectVisual from './ProjectVisual.astro';
import type { Project } from '@/data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;

const deviceStates = [
  {
    id: 'desktop',
    label: 'Computador',
    copy: 'Experiência completa',
    previewSize: 'hero',
  },
  {
    id: 'tablet',
    label: 'Tablet',
    copy: 'Conteúdo reorganizado',
    previewSize: 'hero',
  },
  {
    id: 'phone',
    label: 'Telemóvel',
    copy: 'Navegação imediata',
    previewSize: 'card',
  },
] as const;
---

<section
  class="responsive-showcase"
  aria-labelledby="responsive-showcase-title"
  data-responsive-showcase
>
  <div class="responsive-showcase__sticky" data-showcase-sticky>
    <div class="section-shell responsive-showcase__inner">
      <header class="responsive-showcase__heading">
        <span class="eyebrow">Uma presença coerente</span>
        <h2 id="responsive-showcase-title">O mesmo website. Em todos os ecrãs.</h2>
        <p>Uma experiência clara e consistente no computador, no tablet e no telemóvel.</p>
      </header>

      <div class="responsive-showcase__motion" data-showcase-motion>
        <div class="responsive-showcase__visual" data-showcase-stage>
          <div class="responsive-showcase__rings" aria-hidden="true">
            <i></i><i></i><i></i>
          </div>
          <span class="responsive-showcase__glow" aria-hidden="true"></span>
          <span class="responsive-showcase__signal" aria-hidden="true"></span>

          <div
            class="responsive-showcase__device"
            data-showcase-device
            role="img"
            aria-label="Projeto conceito Lúmen Clínica apresentado num computador"
          >
            <div class="responsive-showcase__browser-bar" aria-hidden="true">
              <span><i></i><i></i><i></i></span>
              <small>lumenclinica.pt</small>
            </div>
            <span class="responsive-showcase__sensor" aria-hidden="true"></span>

            <div class="responsive-showcase__screen">
              {
                deviceStates.map((state) => (
                  <div
                    class:list={[
                      'responsive-showcase__view',
                      `responsive-showcase__view--${state.id}`,
                    ]}
                    data-showcase-view={state.id}
                    aria-hidden={state.id === 'desktop' ? 'false' : 'true'}
                  >
                    <div class="responsive-showcase__site-nav">
                      <strong>lúmen</strong>
                      {state.id !== 'phone' && <span>Especialidades</span>}
                      {state.id === 'desktop' && <span>Equipa</span>}
                      {
                        state.id === 'phone' ? (
                          <b class="responsive-showcase__menu-icon" aria-hidden="true">
                            <i></i><i></i>
                          </b>
                        ) : (
                          <b class="responsive-showcase__nav-cta">Marcar consulta</b>
                        )
                      }
                    </div>
                    <div class="responsive-showcase__page">
                      <ProjectVisual project={project} size={state.previewSize} />
                    </div>
                    {
                      state.id === 'tablet' && (
                        <div class="responsive-showcase__tablet-panel" aria-hidden="true">
                          <small>Consulta simples</small>
                          <strong>Escolha a especialidade</strong>
                          <span>Ver disponibilidade <i>→</i></span>
                        </div>
                      )
                    }
                    {
                      state.id === 'phone' && (
                        <div class="responsive-showcase__mobile-menu" aria-hidden="true">
                          <small>Menu</small>
                          <span>Especialidades</span>
                          <span>Equipa</span>
                          <b>Marcar consulta <i>→</i></b>
                        </div>
                      )
                    }
                  </div>
                ))
              }
            </div>
          </div>
        </div>

        <div class="responsive-showcase__meta">
          <p class="responsive-showcase__status" aria-live="polite">
            <strong data-showcase-label>Computador</strong>
            <span data-showcase-copy>Experiência completa</span>
          </p>

          <ol class="responsive-showcase__progress" aria-label="Formatos demonstrados">
            {
              deviceStates.map((state, index) => (
                <li
                  class:list={{ 'is-active': index === 0 }}
                  data-showcase-step={state.id}
                  aria-current={index === 0 ? 'step' : undefined}
                >
                  <i aria-hidden="true"></i>
                  <span>{state.label}</span>
                </li>
              ))
            }
          </ol>
        </div>
      </div>

      <div class="responsive-showcase__fallback">
        {
          deviceStates.map((state) => (
            <figure class:list={['responsive-showcase__fallback-item', `responsive-showcase__fallback-item--${state.id}`]}>
              <div
                class:list={['responsive-showcase__fallback-device', `responsive-showcase__fallback-device--${state.id}`]}
                role="img"
                aria-label={`Projeto conceito Lúmen Clínica apresentado num ${state.label.toLowerCase()}`}
              >
                {
                  state.id === 'desktop' && (
                    <div class="responsive-showcase__fallback-browser" aria-hidden="true">
                      <span><i></i><i></i><i></i></span>
                      <small>lumenclinica.pt</small>
                    </div>
                  )
                }
                {state.id !== 'desktop' && <span class="responsive-showcase__fallback-sensor" aria-hidden="true"></span>}
                <div class="responsive-showcase__fallback-screen">
                  <div class:list={['responsive-showcase__view', `responsive-showcase__view--${state.id}`]}>
                    <div class="responsive-showcase__site-nav">
                      <strong>lúmen</strong>
                      {state.id !== 'phone' && <span>Especialidades</span>}
                      {state.id === 'desktop' && <span>Equipa</span>}
                      {
                        state.id === 'phone' ? (
                          <b class="responsive-showcase__menu-icon" aria-hidden="true"><i></i><i></i></b>
                        ) : (
                          <b class="responsive-showcase__nav-cta">Marcar consulta</b>
                        )
                      }
                    </div>
                    <div class="responsive-showcase__page">
                      <ProjectVisual project={project} size={state.previewSize} />
                    </div>
                    {
                      state.id === 'tablet' && (
                        <div class="responsive-showcase__tablet-panel" aria-hidden="true">
                          <small>Consulta simples</small>
                          <strong>Escolha a especialidade</strong>
                          <span>Ver disponibilidade <i>→</i></span>
                        </div>
                      )
                    }
                  </div>
                </div>
              </div>
              <figcaption>
                <strong>{state.label}</strong>
                <span>{state.copy}</span>
              </figcaption>
            </figure>
          ))
        }
        <p class="responsive-showcase__fallback-caption">
          Demonstração responsiva do projeto conceito Lúmen Clínica.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  const showcases = Array.from(document.querySelectorAll<HTMLElement>('[data-responsive-showcase]'));

  showcases.forEach((showcase) => {
    const sticky = showcase.querySelector<HTMLElement>('[data-showcase-sticky]');
    const stage = showcase.querySelector<HTMLElement>('[data-showcase-stage]');
    const device = showcase.querySelector<HTMLElement>('[data-showcase-device]');
    const label = showcase.querySelector<HTMLElement>('[data-showcase-label]');
    const copy = showcase.querySelector<HTMLElement>('[data-showcase-copy]');
    const views = Array.from(showcase.querySelectorAll<HTMLElement>('[data-showcase-view]'));
    const steps = Array.from(showcase.querySelectorAll<HTMLElement>('[data-showcase-step]'));
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const compactLayout = window.matchMedia('(max-width: 44rem)');

    if (!sticky || !stage || !device || !label || !copy) return;

    const states = {
      desktop: {
        label: 'Computador',
        copy: 'Experiência completa',
        aria: 'Projeto conceito Lúmen Clínica apresentado num computador',
      },
      tablet: {
        label: 'Tablet',
        copy: 'Conteúdo reorganizado',
        aria: 'Projeto conceito Lúmen Clínica apresentado num tablet',
      },
      phone: {
        label: 'Telemóvel',
        copy: 'Navegação imediata',
        aria: 'Projeto conceito Lúmen Clínica apresentado num telemóvel',
      },
    } as const;

    type Phase = keyof typeof states;

    let frame = 0;
    let phase: Phase = 'desktop';
    let enhanced = false;
    let isNearViewport = true;

    const clamp = (value: number, minimum = 0, maximum = 1) =>
      Math.min(maximum, Math.max(minimum, value));
    const lerp = (start: number, end: number, amount: number) => start + (end - start) * amount;
    const smooth = (start: number, end: number, value: number) => {
      const amount = clamp((value - start) / (end - start));
      return amount * amount * (3 - 2 * amount);
    };

    const setPhase = (nextPhase: Phase) => {
      if (phase === nextPhase && showcase.dataset.phase) return;
      phase = nextPhase;
      showcase.dataset.phase = nextPhase;
      label.textContent = states[nextPhase].label;
      copy.textContent = states[nextPhase].copy;
      device.setAttribute('aria-label', states[nextPhase].aria);

      views.forEach((view) => {
        view.setAttribute('aria-hidden', view.dataset.showcaseView === nextPhase ? 'false' : 'true');
      });

      steps.forEach((step) => {
        const active = step.dataset.showcaseStep === nextPhase;
        step.classList.toggle('is-active', active);
        if (active) step.setAttribute('aria-current', 'step');
        else step.removeAttribute('aria-current');
      });
    };

    const update = () => {
      frame = 0;
      if (!enhanced || !isNearViewport) return;

      const rect = showcase.getBoundingClientRect();
      if (rect.bottom < 0 || rect.top > window.innerHeight * 1.35) return;

      const stickyHeight = sticky.offsetHeight;
      const travel = Math.max(1, showcase.offsetHeight - stickyHeight);
      const headerHeight =
        Number.parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-height')) || 84;
      const progress = clamp((headerHeight - rect.top) / travel);

      const firstMorph = smooth(0.12, 0.36, progress);
      const secondMorph = smooth(0.46, 0.7, progress);
      const stageWidth = stage.clientWidth;
      const stageHeight = stage.clientHeight;

      const desktopWidth = Math.min(stageWidth * 0.84, 880, stageHeight * 1.78);
      const tabletWidth = Math.min(stageWidth * 0.62, 650, stageHeight * 1.38);
      const phoneWidth = Math.min(stageWidth * 0.31, 310, stageHeight * 0.55);
      const desktopHeight = desktopWidth * 0.56;
      const tabletHeight = tabletWidth * 0.73;
      const phoneHeight = phoneWidth * 1.78;

      const tabletStageWidth = lerp(desktopWidth, tabletWidth, firstMorph);
      const tabletStageHeight = lerp(desktopHeight, tabletHeight, firstMorph);
      const width = lerp(tabletStageWidth, phoneWidth, secondMorph);
      const height = lerp(tabletStageHeight, phoneHeight, secondMorph);

      const desktopOpacity = 1 - smooth(0.23, 0.37, progress);
      const tabletOpacity = smooth(0.23, 0.37, progress) * (1 - smooth(0.55, 0.69, progress));
      const phoneOpacity = smooth(0.55, 0.69, progress);
      const browserOpacity = 1 - smooth(0.14, 0.34, progress);
      const sensorOpacity = smooth(0.56, 0.72, progress);
      const browserHeight = lerp(34, 0, smooth(0.16, 0.37, progress));
      const radius = lerp(20, 30, firstMorph) + secondMorph * 18;
      const bezel = lerp(8, 12, firstMorph) + secondMorph * 2;
      const glowOpacity = smooth(0.58, 0.78, progress) * 0.72;

      showcase.style.setProperty('--showcase-progress', progress.toFixed(4));
      showcase.style.setProperty('--device-width', `${width.toFixed(2)}px`);
      showcase.style.setProperty('--device-height', `${height.toFixed(2)}px`);
      showcase.style.setProperty('--device-radius', `${radius.toFixed(2)}px`);
      showcase.style.setProperty('--device-bezel', `${bezel.toFixed(2)}px`);
      showcase.style.setProperty('--browser-height', `${browserHeight.toFixed(2)}px`);
      showcase.style.setProperty('--browser-opacity', browserOpacity.toFixed(3));
      showcase.style.setProperty('--sensor-opacity', sensorOpacity.toFixed(3));
      showcase.style.setProperty('--desktop-opacity', desktopOpacity.toFixed(3));
      showcase.style.setProperty('--tablet-opacity', tabletOpacity.toFixed(3));
      showcase.style.setProperty('--phone-opacity', phoneOpacity.toFixed(3));
      showcase.style.setProperty('--desktop-shift', `${lerp(0, -12, firstMorph).toFixed(2)}px`);
      showcase.style.setProperty('--tablet-shift', `${lerp(8, -10, smooth(0.28, 0.68, progress)).toFixed(2)}px`);
      showcase.style.setProperty('--phone-shift', `${lerp(12, -8, smooth(0.58, 0.92, progress)).toFixed(2)}px`);
      showcase.style.setProperty('--ring-scale', `${lerp(0.97, 1.04, progress).toFixed(3)}`);
      showcase.style.setProperty('--glow-opacity', glowOpacity.toFixed(3));
      showcase.style.setProperty('--signal-x', `${(Math.sin(progress * Math.PI) * 18).toFixed(2)}px`);
      showcase.style.setProperty('--signal-y', `${lerp(12, -8, progress).toFixed(2)}px`);

      showcase.toggleAttribute('data-menu-open', progress > 0.82);

      if (progress < 0.32) setPhase('desktop');
      else if (progress < 0.63) setPhase('tablet');
      else setPhase('phone');
    };

    const requestUpdate = () => {
      if (!frame) frame = window.requestAnimationFrame(update);
    };

    const applyMode = () => {
      enhanced = !reducedMotion.matches && !compactLayout.matches;
      showcase.classList.toggle('is-enhanced', enhanced);

      if (enhanced) {
        requestUpdate();
      } else {
        showcase.removeAttribute('data-menu-open');
        showcase.removeAttribute('data-phase');
        phase = 'desktop';
      }
    };

    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate);
    reducedMotion.addEventListener('change', applyMode);
    compactLayout.addEventListener('change', applyMode);

    if ('ResizeObserver' in window) {
      const resizeObserver = new ResizeObserver(requestUpdate);
      resizeObserver.observe(stage);
    }

    if ('IntersectionObserver' in window) {
      const sectionObserver = new IntersectionObserver(
        ([entry]) => {
          isNearViewport = Boolean(entry?.isIntersecting);
          if (isNearViewport) requestUpdate();
        },
        { rootMargin: '100% 0px' },
      );
      sectionObserver.observe(showcase);
    }

    applyMode();
  });
</script>

<style>
  .responsive-showcase {
    --device-width: 46rem;
    --device-height: 27.6rem;
    --device-radius: 20px;
    --device-bezel: 8px;
    --browser-height: 34px;
    --browser-opacity: 1;
    --sensor-opacity: 0;
    --desktop-opacity: 1;
    --tablet-opacity: 0;
    --phone-opacity: 0;
    --desktop-shift: 0px;
    --tablet-shift: 8px;
    --phone-shift: 12px;
    --ring-scale: 0.97;
    --glow-opacity: 0;
    --signal-x: 0px;
    --signal-y: 12px;
    position: relative;
    overflow: clip;
    padding-block: clamp(6rem, 9vw, 9rem);
    isolation: isolate;
    color: var(--paper);
    background:
      radial-gradient(circle at 72% 42%, rgb(83 104 255 / 23%), transparent 36%),
      radial-gradient(circle at 36% 78%, rgb(28 39 73 / 48%), transparent 42%),
      var(--ink);
  }

  .responsive-showcase::before {
    position: absolute;
    z-index: -1;
    opacity: 0.045;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.78' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.65'/%3E%3C/svg%3E");
    background-size: 10rem 10rem;
    content: '';
    inset: 0;
    pointer-events: none;
  }

  .responsive-showcase.is-enhanced {
    min-height: 270svh;
    padding-block: 0;
  }

  .responsive-showcase__sticky {
    position: relative;
  }

  .responsive-showcase.is-enhanced .responsive-showcase__sticky {
    position: sticky;
    top: calc(var(--header-height) + 0.75rem);
    display: flex;
    min-height: calc(100svh - var(--header-height) - 0.75rem);
    align-items: center;
  }

  .responsive-showcase__inner {
    width: 100%;
  }

  .responsive-showcase__heading {
    display: grid;
    grid-template-columns: minmax(9rem, 0.32fr) minmax(0, 1.16fr) minmax(16rem, 0.52fr);
    gap: var(--space-lg);
    align-items: end;
  }

  .responsive-showcase__heading h2 {
    max-width: 62rem;
    font-size: clamp(4rem, 7vw, 7.75rem);
    line-height: 0.9;
    letter-spacing: -0.065em;
  }

  .responsive-showcase__heading p {
    max-width: 31rem;
    color: rgb(242 240 232 / 68%);
    font-size: var(--step-1);
  }

  .responsive-showcase__motion {
    display: none;
    margin-top: clamp(2rem, 3.5vw, 3.5rem);
  }

  .responsive-showcase.is-enhanced .responsive-showcase__motion {
    display: block;
  }

  .responsive-showcase__visual {
    position: relative;
    display: grid;
    min-height: clamp(21rem, 46vh, 31rem);
    place-items: center;
  }

  .responsive-showcase__rings {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(54rem, 78vw);
    border: 1px solid rgb(242 240 232 / 11%);
    border-radius: 50%;
    aspect-ratio: 1.7;
    transform: translate(-50%, -50%) scale(var(--ring-scale));
    will-change: transform;
  }

  .responsive-showcase__rings i {
    position: absolute;
    border: 1px solid rgb(242 240 232 / 9%);
    border-radius: inherit;
    inset: calc(var(--ring-index, 0) * 12%);
  }

  .responsive-showcase__rings i:nth-child(2) {
    --ring-index: 1;
  }

  .responsive-showcase__rings i:nth-child(3) {
    --ring-index: 2;
  }

  .responsive-showcase__glow {
    position: absolute;
    top: 52%;
    left: 50%;
    width: min(28rem, 64vw);
    border-radius: 50%;
    opacity: var(--glow-opacity);
    aspect-ratio: 1;
    background: rgb(201 255 85 / 34%);
    filter: blur(5rem);
    transform: translate(-50%, -50%);
    will-change: opacity;
  }

  .responsive-showcase__signal {
    position: absolute;
    z-index: 3;
    top: 20%;
    right: clamp(6%, 14vw, 20%);
    width: 0.72rem;
    border: 3px solid rgb(17 19 24 / 64%);
    border-radius: 50%;
    aspect-ratio: 1;
    background: var(--signal);
    box-shadow: 0 0 0 0.45rem rgb(255 88 56 / 12%);
    transform: translate3d(var(--signal-x), var(--signal-y), 0);
    will-change: transform;
  }

  .responsive-showcase__device {
    position: absolute;
    z-index: 2;
    top: 50%;
    left: 50%;
    display: flex;
    width: min(var(--device-width), 100%);
    height: var(--device-height);
    flex-direction: column;
    overflow: hidden;
    padding: var(--device-bezel);
    border: 1px solid rgb(242 240 232 / 20%);
    border-radius: var(--device-radius);
    background: #101319;
    box-shadow:
      0 2.4rem 6rem rgb(0 0 0 / 34%),
      inset 0 0 0 1px rgb(255 255 255 / 5%);
    transform: translate3d(-50%, -50%, 0);
    will-change: width, height, border-radius;
  }

  .responsive-showcase__browser-bar {
    display: flex;
    flex: 0 0 var(--browser-height);
    gap: 0.7rem;
    align-items: center;
    min-height: 0;
    overflow: hidden;
    padding-inline: 0.35rem;
    opacity: var(--browser-opacity);
    transition: padding 0.16s linear;
  }

  .responsive-showcase__browser-bar > span,
  .responsive-showcase__fallback-browser > span {
    display: flex;
    gap: 0.3rem;
  }

  .responsive-showcase__browser-bar i,
  .responsive-showcase__fallback-browser i {
    width: 0.4rem;
    border-radius: 50%;
    aspect-ratio: 1;
    background: var(--signal);
  }

  .responsive-showcase__browser-bar i:nth-child(2),
  .responsive-showcase__fallback-browser i:nth-child(2) {
    background: #f1c75b;
  }

  .responsive-showcase__browser-bar i:nth-child(3),
  .responsive-showcase__fallback-browser i:nth-child(3) {
    background: #6dbb82;
  }

  .responsive-showcase__browser-bar small,
  .responsive-showcase__fallback-browser small {
    margin-left: auto;
    color: rgb(242 240 232 / 52%);
    font-size: 0.55rem;
    letter-spacing: 0.04em;
  }

  .responsive-showcase__sensor {
    position: absolute;
    z-index: 7;
    top: 0.78rem;
    left: 50%;
    width: 25%;
    height: 0.32rem;
    border-radius: 1rem;
    opacity: var(--sensor-opacity);
    background: #32363d;
    transform: translateX(-50%);
  }

  .responsive-showcase__screen,
  .responsive-showcase__fallback-screen {
    position: relative;
    min-height: 0;
    flex: 1;
    overflow: hidden;
    border-radius: max(0.85rem, calc(var(--device-radius) - var(--device-bezel)));
    background: #a9dfc5;
  }

  .responsive-showcase__view {
    position: absolute;
    overflow: hidden;
    background: #a9dfc5;
    inset: 0;
  }

  .responsive-showcase__view--desktop {
    opacity: var(--desktop-opacity);
    transform: translate3d(0, var(--desktop-shift), 0);
  }

  .responsive-showcase__view--tablet {
    opacity: var(--tablet-opacity);
    transform: translate3d(0, var(--tablet-shift), 0);
  }

  .responsive-showcase__view--phone {
    opacity: var(--phone-opacity);
    transform: translate3d(0, var(--phone-shift), 0);
  }

  .responsive-showcase__site-nav {
    position: absolute;
    z-index: 5;
    top: 0;
    display: flex;
    width: 100%;
    gap: clamp(0.45rem, 1.4vw, 1.25rem);
    align-items: center;
    padding: clamp(0.55rem, 1.25vw, 0.9rem) clamp(0.7rem, 1.7vw, 1.2rem);
    color: #13372c;
    background: rgb(242 240 232 / 91%);
    box-shadow: 0 1px rgb(19 55 44 / 7%);
    backdrop-filter: blur(0.5rem);
    font-size: clamp(0.42rem, 0.65vw, 0.62rem);
  }

  .responsive-showcase__site-nav strong {
    margin-right: auto;
    font-family: var(--font-serif);
    font-size: clamp(0.9rem, 1.6vw, 1.35rem);
    font-weight: 400;
  }

  .responsive-showcase__nav-cta {
    padding: 0.45rem 0.65rem;
    color: var(--paper);
    border-radius: 3rem;
    background: #15382d;
    box-shadow: 0 0 0 0 rgb(201 255 85 / 0%);
    transition: box-shadow 0.35s var(--ease);
  }

  .responsive-showcase[data-phase='tablet'] .responsive-showcase__nav-cta {
    box-shadow: 0 0 0 0.18rem rgb(201 255 85 / 38%);
  }

  .responsive-showcase__menu-icon {
    display: grid;
    width: 1.55rem;
    border-radius: 50%;
    aspect-ratio: 1;
    background: #15382d;
    place-content: center;
  }

  .responsive-showcase__menu-icon i {
    display: block;
    width: 0.68rem;
    height: 1px;
    margin-block: 0.1rem;
    background: var(--paper);
  }

  .responsive-showcase__page {
    height: 100%;
  }

  .responsive-showcase__page :global(.project-visual) {
    height: 100%;
    min-height: 100%;
    border-radius: 0;
  }

  .responsive-showcase__view--desktop :global(.lumen-word) {
    top: 12%;
    font-size: clamp(2.3rem, 5vw, 4.8rem);

---
import ProjectVisual from './ProjectVisual.astro';
import type { Project } from '@/data/projects';

interface Props {
  project: Project;
  variant: 'browser' | 'tablet' | 'phone';
  videoSrc?: string;
  posterSrc?: string;
  class?: string;
}

const { project, variant, videoSrc, posterSrc, class: className = '' } = Astro.props;
const previewSize = variant === 'phone' ? 'card' : 'hero';
const accessibleLabel = videoSrc
  ? variant === 'phone'
    ? 'Website a ser utilizado num telemóvel'
    : 'Vídeo sobre desenvolvimento web apresentado no ecrã de um computador'
  : `Pré-visualização responsiva do ${project.tag.toLowerCase()} ${project.title} num ${variant === 'browser' ? 'computador' : variant === 'tablet' ? 'tablet' : 'telemóvel'}`;
---

<div
  class:list={['website-frame', `website-frame--${variant}`, className]}
  role="img"
  aria-label={accessibleLabel}
>
  {
    variant === 'browser' && (
      <div class="website-frame__browser-bar" aria-hidden="true">
        <span class="website-frame__controls"><i></i><i></i><i></i></span>
        <span class="website-frame__address">lumenclinica.pt</span>
      </div>
    )
  }
  {
    variant !== 'browser' && (
      <span class:list={['website-frame__sensor', `website-frame__sensor--${variant}`]} aria-hidden="true"></span>
    )
  }
  <div class="website-frame__screen">
    {
      videoSrc ? (
        <video
          class="website-frame__video"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={posterSrc}
          disablepictureinpicture
          aria-label={accessibleLabel}
          data-viewport-video
        >
          <source src={videoSrc} type="video/mp4" />
        </video>
      ) : (
        <>
          <div class="website-frame__site-nav" aria-hidden="true">
            <strong>lúmen</strong>
            <span>Especialidades</span>
            <span>Equipa</span>
            <b>Marcar consulta</b>
          </div>
          <ProjectVisual project={project} size={previewSize} />
        </>
      )
    }
  </div>
</div>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ButtonLink from '@/components/ButtonLink.astro';
import WebsiteFrame from '@/components/WebsiteFrame.astro';
import ResponsiveDeviceShowcase from '@/components/ResponsiveDeviceShowcase.astro';
import HomeProcess from '@/components/HomeProcess.astro';
import HomeGrowthCta from '@/components/HomeGrowthCta.astro';
import { projects } from '@/data/projects';
import { siteConfig } from '@/config/site';

const previewProject = projects.find((project) => project.slug === 'lumen-clinica')!;

const benefits = [
  {
    title: 'Percebe-se rapidamente',
    text: 'O seu negócio fica claro desde o primeiro olhar.',
    visual: 'clarity',
  },
  {
    title: 'Funciona em qualquer ecrã',
    text: 'Uma experiência fluida no computador e no telemóvel.',
    visual: 'screens',
  },
  {
    title: 'É mais fácil de encontrar',
    text: 'Uma estrutura preparada para dar visibilidade ao seu negócio.',
    visual: 'search',
  },
  {
    title: 'Transforma interesse em contactos',
    text: 'Percursos simples que orientam o visitante para o próximo passo.',
    visual: 'contact',
  },
];

const processSteps = [
  { title: 'Perceber', text: 'Definimos o que o website precisa de alcançar.' },
  { title: 'Criar', text: 'Desenhamos uma experiência clara e adequada à sua marca.' },
  { title: 'Construir', text: 'Desenvolvemos um website rápido e adaptado a todos os ecrãs.' },
  { title: 'Evoluir', text: 'Continuamos disponíveis depois do lançamento.' },
];
---

<BaseLayout
  title={siteConfig.name}
  description="Criamos websites rápidos, claros e preparados para transformar visitas em oportunidades para empresas em Portugal."
>
  <section class="home-essential-hero">
    <div class="home-signal-backdrop" aria-hidden="true">
      <div class="signal-glow signal-glow--blue"></div>
      <div class="signal-glow signal-glow--orange"></div>
      <div class="signal-field">
        <i></i><i></i><i></i><i></i><i></i>
        <b></b>
      </div>
      <span class="signal-wordmark">SINAL</span>
    </div>

    <div class="home-essential-copy" data-reveal>
      <span class="eyebrow home-essential-eyebrow">
        Websites com <strong><i aria-hidden="true"></i>Sinal</strong> para crescer
      </span>
      <h1>O seu negócio merece um site <em>à altura.</em></h1>
      <div class="home-essential-intro">
        <p>{siteConfig.valueProposition}</p>
        <div class="button-row">
          <ButtonLink href="/diagnostico" label="Pedir diagnóstico gratuito" variant="signal" />
          <ButtonLink href="/projetos" label="Ver projetos" variant="line" />
        </div>
      </div>
    </div>

    <div class="home-feature-rail" aria-label="Características principais">
      <span>Mensagem clara</span>
      <span>Rápido em qualquer ecrã</span>
      <span>Mais fácil de encontrar</span>
      <span>Mais contactos</span>
    </div>
  </section>

  <section class="home-product-intro section-shell" id="caracteristicas">
    <div class="home-product-copy" data-reveal>
      <span class="eyebrow">O website certo</span>
      <h2>Um website preparado para fazer crescer o seu negócio.</h2>
      <p>Claro, rápido e pensado para transformar visitas em contactos.</p>
      <div class="button-row">
        <ButtonLink href="/diagnostico" label="Pedir diagnóstico gratuito" variant="signal" />
        <a class="text-link" href="/projetos"><span>Ver projetos</span><i aria-hidden="true">↗</i></a>
      </div>
    </div>

    <div class="home-product-stage" data-reveal>
      <div class="home-product-rings" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
      <WebsiteFrame
        project={previewProject}
        variant="browser"
        videoSrc="/videos/programador.mp4"
        class="home-product-browser"
      />
      <span class="home-float-label home-float-label--screens">Adaptado a todos os ecrãs</span>
      <span class="home-float-label home-float-label--speed">Rápido e fácil de utilizar</span>
      <small>Projeto conceito — Lúmen Clínica</small>
    </div>
  </section>

  <section class="home-benefits section-shell" aria-labelledby="benefits-title">
    <header class="home-editorial-heading" data-reveal>
      <span class="eyebrow">O que realmente importa</span>
      <h2 id="benefits-title">O essencial, sem complicações.</h2>
    </header>

    <div class="home-benefit-flow">
      <svg
        class="home-benefit-signal-path"
        viewBox="0 0 100 1000"
        preserveAspectRatio="none"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M50 0 C15 90 15 160 50 250 S85 410 50 500 S15 660 50 750 S85 910 50 1000"></path>
      </svg>
      {
        benefits.map((benefit, index) => (
          <article class:list={[`home-benefit--${benefit.visual}`, index % 2 === 1 && 'home-benefit--right']} data-reveal>
            {
              benefit.visual === 'clarity' ? (
                <div class="home-benefit-video-composition" data-video-observer-root>
                  <i
                    class="home-benefit-video-ring home-benefit-video-ring--outer"
                    data-scroll-shift="-4"
                    aria-hidden="true"
                  ></i>
                  <i
                    class="home-benefit-video-ring home-benefit-video-ring--inner"
                    data-scroll-shift="5"
                    aria-hidden="true"
                  ></i>
                  <div class="home-benefit-video-shell">
                    <video
                      class="home-benefit-video"
                      autoplay
                      muted
                      loop
                      playsinline
                      preload="metadata"
                      disablepictureinpicture
                      aria-label="Pessoa a observar um website no computador"
                      data-viewport-video
                    >
                      <source src="/videos/percebe-se-rapidamente.mp4" type="video/mp4" />
                    </video>
                  </div>
                  <span class="home-benefit-video-signal" aria-hidden="true"></span>
                </div>
              ) : benefit.visual === 'screens' ? (
                <div class="home-benefit-device-composition" data-video-observer-root>
                  <span class="home-benefit-device-halo" aria-hidden="true"></span>
                  <div class="home-benefit-device-waves" aria-hidden="true">
                    <i></i><i></i><i></i>
                  </div>
                  <div class="home-benefit-device-monitor">
                    <div class="home-benefit-device-bar" aria-hidden="true">
                      <i></i><i></i><i></i>
                    </div>
                    <div class="home-benefit-device-screen">
                      <video
                        class="home-benefit-device-video"
                        autoplay
                        muted
                        loop
                        playsinline
                        preload="metadata"
                        disablepictureinpicture
                        aria-label="Website a ser testado em diferentes dispositivos"
                        data-viewport-video
                      >
                        <source src="/videos/qualquer-ecra.mp4" type="video/mp4" />
                      </video>
                    </div>
                  </div>
                  <span class="home-benefit-device-signal" aria-hidden="true"></span>
                </div>
              ) : benefit.visual === 'search' ? (
                <div class="home-benefit-search-composition" data-video-observer-root>
                  <span class="home-benefit-search-halo" aria-hidden="true"></span>
                  <div class="home-benefit-search-rings" aria-hidden="true">
                    <i></i><i></i><i></i>
                  </div>
                  <div class="home-benefit-search-video-shell">
                    <video
                      class="home-benefit-search-video"
                      autoplay
                      muted
                      loop
                      playsinline
                      preload="metadata"
                      disablepictureinpicture
                      aria-label="Pessoa a pesquisar e encontrar um negócio na internet"
                      data-viewport-video
                    >
                      <source src="/videos/mais-facil-encontrar.mp4" type="video/mp4" />
                    </video>
                  </div>
                  <div class="home-benefit-search-bar" aria-hidden="true">
                    <i></i>
                    <span></span>
                    <b></b>
                  </div>
                </div>
              ) : benefit.visual === 'contact' ? (
                <div class="home-benefit-contact-composition" data-video-observer-root>
                  <span class="home-benefit-contact-halo" aria-hidden="true"></span>
                  <div class="home-benefit-contact-video-shell">
                    <video
                      class="home-benefit-contact-video"
                      autoplay
                      muted
                      loop
                      playsinline
                      preload="metadata"
                      disablepictureinpicture
                      aria-label="Pessoa a receber um contacto relacionado com o seu negócio"
                      data-viewport-video
                    >
                      <source src="/videos/transforma-em-contactos.mp4" type="video/mp4" />
                    </video>
                  </div>
                  <svg
                    class="home-benefit-contact-path"
                    viewBox="0 0 190 82"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d="M6 66 C52 66 48 18 102 18 H170"></path>
                    <circle class="home-benefit-contact-path-start" cx="6" cy="66" r="3"></circle>
                    <circle class="home-benefit-contact-path-signal" cx="170" cy="18" r="9"></circle>
                    <circle class="home-benefit-contact-path-core" cx="170" cy="18" r="3"></circle>
                  </svg>
                </div>
              ) : (
                <div class="home-benefit-visual" aria-hidden="true">
                  <i></i><i></i><i></i>
                  <span></span>
                </div>
              )
            }
            <div>
              <h3>{benefit.title}</h3>
              <p>{benefit.text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <ResponsiveDeviceShowcase project={previewProject} />

  <HomeProcess steps={processSteps} />

  <HomeGrowthCta />

  <script>
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const shiftedElements = Array.from(document.querySelectorAll<HTMLElement>('[data-scroll-shift]'));
      let frame = 0;

      const updateShift = () => {
        frame = 0;
        shiftedElements.forEach((element) => {
          const rect = element.getBoundingClientRect();
          const strength = Number(element.dataset.scrollShift ?? 0);
          const progress = Math.max(-1, Math.min(1, (window.innerHeight * 0.5 - rect.top) / window.innerHeight));
          element.style.setProperty('--scroll-shift', `${progress * strength}px`);
        });
      };

      const requestShift = () => {
        if (!frame) frame = window.requestAnimationFrame(updateShift);
      };

      window.addEventListener('scroll', requestShift, { passive: true });
      window.addEventListener('resize', requestShift);
      updateShift();
    }

    const viewportVideos = Array.from(document.querySelectorAll<HTMLVideoElement>('[data-viewport-video]'));
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    if (reducedMotion.matches) {
      viewportVideos.forEach((video) => {
        const showStaticFrame = () => {
          video.pause();
          video.currentTime = Math.min(0.1, Number.isFinite(video.duration) ? video.duration : 0.1);
        };

        video.autoplay = false;
        video.removeAttribute('autoplay');
        if (video.readyState >= 1) showStaticFrame();
        else video.addEventListener('loadedmetadata', showStaticFrame, { once: true });
      });
    } else if ('IntersectionObserver' in window) {
      const videoObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const target = entry.target as HTMLElement;
            const videos = target.matches('[data-viewport-video]')
              ? [target as HTMLVideoElement]
              : Array.from(target.querySelectorAll<HTMLVideoElement>('[data-viewport-video]'));

            videos.forEach((video) => {
              if (entry.isIntersecting) void video.play().catch(() => undefined);
              else video.pause();
            });
          });
        },
        { threshold: 0.12 },
      );

      viewportVideos.forEach((video) => {
        video.pause();
        videoObserver.observe(video.closest('[data-video-observer-root], .home-product-stage') ?? video);
      });
    }
  </script>
</BaseLayout>

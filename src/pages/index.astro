---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ButtonLink from '@/components/ButtonLink.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import CTA from '@/components/CTA.astro';
import { projects } from '@/data/projects';
import { siteConfig } from '@/config/site';

const websiteFeatures = [
  {
    number: '01',
    title: 'Mensagem clara',
    text: 'O cliente percebe rapidamente o que faz, para quem e por que deve escolher a sua empresa.',
    href: '/servicos/websites-empresariais',
    label: 'Conhecer websites empresariais',
  },
  {
    number: '02',
    title: 'Rápido em qualquer ecrã',
    text: 'Uma experiência fluida em computador e telemóvel, sem esperas que fazem perder oportunidades.',
    href: '/servicos/seo-performance',
    label: 'Conhecer performance e SEO',
  },
  {
    number: '03',
    title: 'Preparado para o Google',
    text: 'Estrutura, conteúdos e base técnica pensados para facilitar a descoberta do seu negócio.',
    href: '/servicos/seo-performance',
    label: 'Conhecer performance e SEO',
  },
  {
    number: '04',
    title: 'Focado em contactos',
    text: 'Percursos e chamadas para ação que transformam interesse em pedidos de informação ou orçamento.',
    href: '/servicos/landing-pages',
    label: 'Conhecer landing pages',
  },
];
---

<BaseLayout
  title={siteConfig.name}
  description="Criamos websites rápidos, claros e preparados para transformar visitas em oportunidades para empresas em Portugal."
>
  <section class="home-essential-hero">
    <div class="home-signal-backdrop" aria-hidden="true">
      <div class="signal-glow signal-glow--blue"></div>
      <div class="signal-glow signal-glow--orange"></div>
      <div class="signal-field">
        <i></i><i></i><i></i><i></i><i></i>
        <b></b>
      </div>
      <span class="signal-wordmark">SINAL</span>
    </div>

    <div class="home-essential-copy" data-reveal>
      <span class="eyebrow home-essential-eyebrow">
        Websites com <strong><i aria-hidden="true"></i>Sinal</strong> para crescer
      </span>
      <h1>O seu negócio merece um site <em>à altura.</em></h1>
      <div class="home-essential-intro">
        <p>{siteConfig.valueProposition}</p>
        <div class="button-row">
          <ButtonLink href="/diagnostico" label="Pedir diagnóstico gratuito" variant="signal" />
          <ButtonLink href="/projetos" label="Ver projetos" variant="line" />
        </div>
      </div>
    </div>

    <div class="home-feature-rail" aria-label="Características principais">
      <span>Mensagem clara</span>
      <span>Performance</span>
      <span>SEO técnico</span>
      <span>Mais contactos</span>
    </div>
  </section>

  <section class="home-outcomes section-shell" id="caracteristicas">
    <header class="home-section-heading" data-reveal>
      <span class="eyebrow">O website certo</span>
      <h2>Preparado para trabalhar pelo seu negócio.</h2>
      <p>Sem excesso. Apenas o que ajuda a transmitir confiança, ser encontrado e facilitar o próximo passo.</p>
    </header>

    <div class="home-outcome-grid">
      {
        websiteFeatures.map((feature) => (
          <article data-reveal>
            <a href={feature.href} aria-label={feature.label}>
              <span>{feature.number}</span>
              <h3>{feature.title}</h3>
              <p>{feature.text}</p>
              <i aria-hidden="true">↗</i>
            </a>
          </article>
        ))
      }
    </div>

    <div class="home-outcomes-footer" data-reveal>
      <p>Estratégia, design, desenvolvimento e acompanhamento num processo simples de seguir.</p>
      <ButtonLink href="/servicos" label="Ver todos os serviços" variant="line" />
    </div>
  </section>

  <section class="home-selected-work">
    <div class="section-shell">
      <header class="home-section-heading home-section-heading--work" data-reveal>
        <span class="eyebrow">Projetos selecionados</span>
        <h2>Ver antes de decidir.</h2>
        <p>Projetos conceito que mostram como transformamos necessidades comerciais em experiências digitais claras.</p>
      </header>

      <div class="home-project-grid">
        {projects.slice(0, 2).map((project, index) => <ProjectCard project={project} featured={index === 0} />)}
      </div>

      <div class="home-work-footer">
        <ButtonLink href="/projetos" label="Explorar todos os projetos" variant="line" />
      </div>
    </div>
  </section>

  <CTA
    eyebrow="O próximo passo"
    title="O seu website pode fazer mais pelo negócio."
    text="Começamos por identificar o que está a bloquear clareza, confiança ou contactos."
  />
</BaseLayout>

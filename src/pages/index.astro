---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ButtonLink from '@/components/ButtonLink.astro';
import SectionIntro from '@/components/SectionIntro.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import FAQ from '@/components/FAQ.astro';
import CTA from '@/components/CTA.astro';
import { services } from '@/data/services';
import { projects } from '@/data/projects';
import { articles } from '@/data/articles';
import { siteConfig } from '@/config/site';

const homeFaq = [
  {
    question: 'Quanto custa criar um website?',
    answer:
      'Depende da dimensão, conteúdos, integrações e ponto de partida. Depois do diagnóstico, apresentamos um âmbito e investimento claros. Não usamos pacotes vagos nem custos escondidos.',
  },
  {
    question: 'Quanto tempo demora?',
    answer:
      'Um website empresarial demora habitualmente entre 6 e 10 semanas. Projetos mais pequenos podem ser mais rápidos; lojas, conteúdos extensos ou integrações podem exigir mais tempo.',
  },
  {
    question: 'Trabalham com empresas fora de Lisboa e Porto?',
    answer:
      'Sim. O processo foi pensado para colaboração remota com empresas em todo o país, com momentos de decisão claros e documentação partilhada.',
  },
  {
    question: 'Já tenho website. Conseguem dizer-me o que está a falhar?',
    answer:
      'Sim. O diagnóstico gratuito identifica sinais visíveis de fricção, clareza, performance e conversão. Quando é necessária uma auditoria técnica profunda, propomos esse trabalho separadamente.',
  },
  {
    question: 'Ficam responsáveis pela manutenção?',
    answer:
      'Podemos acompanhar o website depois do lançamento ou preparar a sua equipa para o gerir. A solução é definida de acordo com a frequência de atualização e os recursos internos.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: homeFaq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<BaseLayout
  title={siteConfig.name}
  description="Criamos websites rápidos, claros e feitos para transformar visitas em oportunidades para PME e empresas de serviços em Portugal."
  structuredData={faqSchema}
>
  <section class="home-hero">
    <div class="home-hero-grid" aria-hidden="true"></div>
    <div class="home-hero-copy" data-reveal>
      <span class="eyebrow">Websites com sinal para crescer · Portugal</span>
      <h1>O seu negócio merece um site <em>à altura.</em></h1>
      <div class="hero-actions">
        <p>{siteConfig.valueProposition}</p>
        <div class="button-row">
          <ButtonLink href="/diagnostico" label="Pedir diagnóstico gratuito" variant="dark" />
          <ButtonLink href="/projetos" label="Ver projetos" variant="line" arrow="down" />
        </div>
      </div>
    </div>
    <div class="hero-signal-board" aria-hidden="true">
      <div class="hero-board-top"><span>SINAL/ONLINE</span><span>PT—26</span></div>
      <div class="hero-orbit"><i></i><i></i><i></i><i></i><b></b></div>
      <div class="hero-board-type">MENOS<br />RUÍDO.<br /><em>MAIS SINAL.</em></div>
      <div class="hero-board-status"><i></i> Disponíveis para novos projetos</div>
    </div>
    <div class="hero-proof" data-reveal>
      <span>Estratégia antes do ecrã</span>
      <span>Design com intenção</span>
      <span>Tecnologia que não pesa</span>
    </div>
    <a class="hero-scroll" href="#posicionamento"><span>Explorar</span><i aria-hidden="true">↓</i></a>
  </section>

  <section class="positioning-strip" id="posicionamento">
    <div class="ticker-line" aria-hidden="true">
      <span>CLAREZA</span><i>✦</i><span>CREDIBILIDADE</span><i>✦</i><span>PERFORMANCE</span><i>✦</i><span>OPORTUNIDADES</span><i>✦</i>
      <span>CLAREZA</span><i>✦</i><span>CREDIBILIDADE</span><i>✦</i>
    </div>
    <div class="positioning-copy section-shell" data-reveal>
      <span class="eyebrow">Presença digital, não decoração</span>
      <p>
        Um website é muitas vezes a primeira conversa entre a sua empresa e um potencial cliente.
        <strong>Fazemos com que essa conversa seja clara, útil e memorável.</strong>
      </p>
      <a class="text-link" href="/sobre">Conhecer o estúdio <span>↗</span></a>
    </div>
  </section>

  <section class="problem-section">
    <div class="section-shell">
      <SectionIntro
        eyebrow="O problema não é só visual"
        title="O seu website fala antes de si."
        text="Quando está desatualizado, confuso ou lento, a mensagem chega primeiro — mesmo que o seu trabalho seja excelente."
        theme="dark"
      />
      <div class="problem-grid">
        <article data-reveal><span>01</span><h3>Não transmite confiança</h3><p>O negócio evoluiu, mas a presença digital continua presa ao passado.</p></article>
        <article data-reveal><span>02</span><h3>Não explica o valor</h3><p>Os serviços parecem iguais aos da concorrência e as diferenças ficam escondidas.</p></article>
        <article data-reveal><span>03</span><h3>Não facilita o contacto</h3><p>Quem está interessado encontra dúvidas, formulários longos ou caminhos sem saída.</p></article>
        <article data-reveal><span>04</span><h3>Não é encontrado</h3><p>Uma base técnica frágil limita a descoberta no Google e a experiência mobile.</p></article>
        <article class="problem-answer" data-reveal>
          <div class="mini-signal" aria-hidden="true"><i></i><i></i><i></i></div>
          <span>O que muda</span>
          <h3>Clareza gera confiança. Confiança abre oportunidades.</h3>
          <a href="/diagnostico">Perceber onde está a perder sinal <i>↗</i></a>
        </article>
      </div>
    </div>
  </section>

  <section class="services-section section-shell">
    <SectionIntro
      eyebrow="Serviços"
      title="Tudo o que o website precisa. Nada do que não precisa."
      text="Estratégia, conteúdos, design e tecnologia reunidos num processo simples de acompanhar."
    />
    <div class="service-cards">
      {services.map((service) => <ServiceCard service={service} />)}
    </div>
    <div class="section-link"><ButtonLink href="/servicos" label="Explorar todos os serviços" variant="line" /></div>
  </section>

  <section class="featured-work">
    <div class="section-shell">
      <SectionIntro
        eyebrow="Projetos selecionados"
        title="Ideias de negócio, transformadas em experiências."
        text="Enquanto o portefólio real cresce, estes projetos conceito mostram o nível de pensamento, detalhe e direção visual que aplicamos."
      />
      <div class="featured-projects">
        {projects.slice(0, 3).map((project, index) => <ProjectCard project={project} featured={index === 0} />)}
      </div>
      <div class="section-link"><ButtonLink href="/projetos" label="Ver todos os projetos" variant="line" /></div>
    </div>
  </section>

  <section class="process-preview">
    <div class="section-shell">
      <SectionIntro
        eyebrow="Processo"
        title="Sem mistérios. Sempre a saber o que vem a seguir."
        text="Cada fase termina com uma decisão clara. Trabalhamos consigo, não atrás de uma cortina."
      />
      <ol class="process-track">
        {[
          ['01', 'Diagnóstico', 'O negócio, o público e o problema certo.'],
          ['02', 'Estratégia', 'Prioridades, estrutura e conteúdos.'],
          ['03', 'UX & visual', 'Percursos claros e uma direção própria.'],
          ['04', 'Desenvolvimento', 'Uma base rápida, acessível e sustentável.'],
          ['05', 'Lançamento', 'Testes, migração e publicação controlada.'],
          ['06', 'Evolução', 'Aprender com o uso e melhorar com intenção.'],
        ].map(([number, title, text]) => (
          <li data-reveal><span>{number}</span><h3>{title}</h3><p>{text}</p></li>
        ))}
      </ol>
      <a class="text-link" href="/processo">Ver processo completo <span>↗</span></a>
    </div>
  </section>

  <section class="why-section">
    <div class="section-shell">
      <div class="why-lead" data-reveal>
        <span class="eyebrow">Porque Sinal</span>
        <h2>Rigor de estúdio.<br /><em>Clareza de parceiro.</em></h2>
        <p>Sem promessas mágicas. Sem tecnologia escolhida por hábito. Sem decisões que não consegue compreender.</p>
      </div>
      <div class="trust-grid">
        <article data-reveal><span>01</span><h3>Objetivos antes de tendências</h3><p>Cada decisão visual ou técnica responde a uma necessidade real do negócio.</p></article>
        <article data-reveal><span>02</span><h3>Trabalho visível</h3><p>Partilhamos progresso, decisões e próximos passos ao longo do projeto.</p></article>
        <article data-reveal><span>03</span><h3>Sem dependência artificial</h3><p>Entregamos documentação, acessos e uma base que pode continuar consigo.</p></article>
        <article data-reveal><span>04</span><h3>Qualidade que inclui todos</h3><p>Performance, acessibilidade e mobile fazem parte do trabalho desde o início.</p></article>
      </div>
      <div class="trust-note" data-reveal>
        <span class="signal-dot"></span>
        <p>
          <strong>A confiança não precisa de números inventados.</strong>
          Constrói-se com um processo claro, exemplos honestos e trabalho tecnicamente bem executado.
        </p>
      </div>
    </div>
  </section>

  <FAQ items={homeFaq} />

  <section class="insights-preview section-shell">
    <SectionIntro
      eyebrow="Insights"
      title="Decisões digitais explicadas com clareza."
      text="Guias práticos para investir melhor no website e perceber o que realmente importa."
    />
    <div class="article-grid">
      {articles.slice(0, 3).map((article, index) => <ArticleCard article={article} index={index} />)}
    </div>
    <div class="section-link"><ButtonLink href="/insights" label="Explorar todos os artigos" variant="line" /></div>
  </section>

  <CTA />
</BaseLayout>

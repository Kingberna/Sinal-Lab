---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import CTA from '@/components/CTA.astro';
import { articles } from '@/data/articles';

const categories = ['Todos', ...new Set(articles.map((article) => article.category))];
---

<BaseLayout
  title="Insights"
  description="Guias práticos sobre websites, redesign, conversão, SEO local e presença digital para PME portuguesas."
>
  <PageHeader
    eyebrow="Insights"
    title="Melhores decisões. Menos jargão."
    intro="Conteúdo prático para perceber onde investir, o que perguntar e como transformar o website numa parte útil do negócio."
    breadcrumbs={[{ label: 'Início', href: '/' }, { label: 'Insights' }]}
  />

  <section class="editorial-section section-shell">
    <div class="filter-bar filter-bar--editorial" role="group" aria-label="Filtrar artigos por categoria" data-reveal>
      {categories.map((category, index) => (
        <button type="button" data-article-filter={category} aria-pressed={index === 0 ? 'true' : 'false'}>{category}</button>
      ))}
    </div>
    <p class="sr-only" role="status" aria-live="polite" data-article-status>{articles.length} artigos apresentados.</p>
    <div class="article-grid article-grid--archive">
      {articles.map((article, index) => (
        <div data-article data-category={article.category}>
          <ArticleCard article={article} index={index} />
        </div>
      ))}
    </div>
    <div class="empty-state" hidden data-article-empty>
      <h2>Ainda não existem artigos nesta categoria.</h2>
      <button class="button button--line" type="button" data-article-reset>Ver todos</button>
    </div>
  </section>

  <section class="editorial-promise">
    <div class="section-shell">
      <div data-reveal><span class="eyebrow">Compromisso editorial</span><h2>Conteúdo para ajudar a decidir, não para encher um calendário.</h2></div>
      <ul data-reveal><li>Sem promessas de resultados garantidos.</li><li>Sem números apresentados fora de contexto.</li><li>Sem esconder uma resposta simples atrás de jargão.</li></ul>
    </div>
  </section>

  <CTA
    eyebrow="Tem uma pergunta?"
    title="O próximo artigo pode começar no seu desafio."
    text="Se a dúvida é específica do seu website, peça um diagnóstico e damos-lhe contexto aplicado."
  />
</BaseLayout>

<script>
  const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-article-filter]'));
  const articleItems = Array.from(document.querySelectorAll<HTMLElement>('[data-article]'));
  const articleStatus = document.querySelector<HTMLElement>('[data-article-status]');
  const articleEmpty = document.querySelector<HTMLElement>('[data-article-empty]');

  const filterArticles = (category: string) => {
    let count = 0;
    articleItems.forEach((item) => {
      const show = category === 'Todos' || item.dataset.category === category;
      item.hidden = !show;
      if (show) count += 1;
    });
    filterButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.articleFilter === category)));
    if (articleStatus) articleStatus.textContent = `${count} ${count === 1 ? 'artigo apresentado' : 'artigos apresentados'}.`;
    if (articleEmpty) articleEmpty.hidden = count > 0;
  };

  filterButtons.forEach((button) => button.addEventListener('click', () => filterArticles(button.dataset.articleFilter || 'Todos')));
  document.querySelector('[data-article-reset]')?.addEventListener('click', () => filterArticles('Todos'));
</script>
